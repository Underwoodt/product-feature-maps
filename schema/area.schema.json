{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "area.schema.json",
  "title": "Product area feature map",
  "type": "object",
  "required": ["id", "name", "themes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "releases": {
      "description": "Optional override of the shared release lanes.",
      "type": "array",
      "items": { "$ref": "#/$defs/release" }
    },
    "themes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/theme" } }
  },
  "$defs": {
    "release": {
      "type": "object",
      "required": ["id", "label"],
      "properties": { "id": { "type": "string" }, "label": { "type": "string" } }
    },
    "theme": {
      "type": "object",
      "required": ["id", "name", "epics"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "name": { "type": "string" },
        "outcome": { "type": "string", "description": "The user or business outcome this theme serves." },
        "epics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/epic" } }
      }
    },
    "epic": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "release": { "type": "string", "description": "Target lane for the epic as a whole; stories may override." },
        "status": { "type": "string" },
        "stories": { "type": "array", "items": { "$ref": "#/$defs/story" } }
      }
    },
    "story": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "title": { "type": "string" },
        "as_a": { "type": "string" },
        "i_want": { "type": "string" },
        "so_that": { "type": "string" },
        "release": { "type": "string" },
        "status": { "type": "string" },
        "size": { "type": "string", "enum": ["XS", "S", "M", "L", "XL"] },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "link": { "type": "string", "description": "Jira / ADO / GitHub issue URL." },
        "notes": { "type": "string" }
      }
    }
  }
}
